<!-- ULDB: the window of upstream's LinedefEditForm ("Edit Linedef" for Doom and Hexen format maps,
     model-ported: upstream's code runs unchanged). Controls named like upstream's fields are bound
     to them by ModelBinder.BindByName; groups and field order follow upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.LinedefEditFormView"
        Title="Edit Linedef" Width="640" Height="840" MinWidth="620" MinHeight="620" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Margin="0,0,10,0" Grid.IsSharedSizeScope="True">
        <Border Classes="uldb-group">
          <StackPanel Spacing="6">
            <CheckBox x:Name="frontside"/>
            <StackPanel x:Name="frontgroup" Spacing="8">
              <Grid ColumnDefinitions="Auto,92,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                <TextBlock x:Name="label11" Text="Sector index:" Classes="uldb-field"/>
                <ContentControl x:Name="frontsector" Grid.Column="1" Width="92"/>
                <TextBlock x:Name="labelFrontTextureOffset" Grid.Row="1" Classes="uldb-field"/>
                <ContentControl x:Name="frontTextureOffset" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="4"><TextBlock x:Name="label3" Text="Upper" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="fronthigh" Height="130"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="label4" Text="Middle" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="frontmid" Height="130"/></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock x:Name="label5" Text="Lower" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="frontlow" Height="130"/></StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="uldb-group">
          <StackPanel Spacing="6">
            <CheckBox x:Name="backside"/>
            <StackPanel x:Name="backgroup" Spacing="8">
              <Grid ColumnDefinitions="Auto,92,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                <TextBlock x:Name="label12" Text="Sector index:" Classes="uldb-field"/>
                <ContentControl x:Name="backsector" Grid.Column="1" Width="92"/>
                <TextBlock x:Name="labelBackTextureOffset" Grid.Row="1" Classes="uldb-field"/>
                <ContentControl x:Name="backTextureOffset" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="4"><TextBlock x:Name="label10" Text="Upper" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="backhigh" Height="130"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="label9" Text="Middle" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="backmid" Height="130"/></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock x:Name="label8" Text="Lower" Classes="uldb-field" HorizontalAlignment="Center"/><ContentControl x:Name="backlow" Height="130"/></StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="flagsgroup" Classes="uldb-group">
          <StackPanel Spacing="6">
            <TextBlock x:Name="flagsgroupTitle" Text="Flags" Classes="uldb-group-title"/>
            <ContentControl x:Name="flags"/>
          </StackPanel>
        </Border>
        <Border x:Name="actiongroup" Classes="uldb-group">
          <StackPanel Spacing="6">
            <TextBlock x:Name="actiongroupTitle" Text="Action" Classes="uldb-group-title"/>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
              <TextBlock x:Name="label2" Text="Action:" Classes="uldb-field"/>
              <ContentControl x:Name="action" Grid.Column="1"/>
              <Button x:Name="browseaction" Grid.Column="2" Classes="uldb-tool"/>
              <ContentControl x:Name="actionhelp" Grid.Column="3"/>
            </Grid>
            <ContentControl x:Name="argscontrol"/>
            <Grid x:Name="hexenpanel" ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <TextBlock x:Name="activationlabel" Classes="uldb-field"/>
              <ComboBox x:Name="activation" Grid.Column="1" HorizontalAlignment="Stretch"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="idgroup" Classes="uldb-group">
          <StackPanel Spacing="6">
            <TextBlock x:Name="idgroupTitle" Text="Identification" Classes="uldb-group-title"/>
            <ContentControl x:Name="tagSelector"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
