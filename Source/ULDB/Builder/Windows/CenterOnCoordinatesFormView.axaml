<!-- ULDB: the window of upstream's CenterOnCoordinatesForm ("Go To Coordinates", model-ported). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.CenterOnCoordinatesFormView"
        Title="Go To Coordinates" Width="300" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="accept" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,92" RowDefinitions="Auto,Auto" RowSpacing="8">
      <TextBlock x:Name="label1" Classes="uldb-field"/>
      <ContentControl x:Name="gotox" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
      <TextBlock x:Name="label2" Grid.Row="1" Classes="uldb-field"/>
      <ContentControl x:Name="gotoy" Grid.Row="1" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
    </Grid>
  </DockPanel>
</Window>
