<!-- ULDB: the window of upstream's SectorEditForm ("Edit Sector" for Doom and Hexen format maps,
     model-ported: upstream's code runs unchanged). Controls named like upstream's fields are bound
     to them by ModelBinder.BindByName; groups and field order follow upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.SectorEditFormView"
        Title="Edit Sector" Width="560" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="10" Grid.IsSharedSizeScope="True">
      <Border x:Name="groupfloorceiling" Classes="uldb-group">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock x:Name="groupfloorceilingTitle" Text="Floor and ceiling" Classes="uldb-group-title"/>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="uldblabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="label6" Text="Ceiling height:" Grid.Row="0" Classes="uldb-field" HorizontalAlignment="Right"/>
              <ContentControl x:Name="ceilingheight" Grid.Row="0" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
              <TextBlock x:Name="label5" Text="Floor height:" Grid.Row="1" Classes="uldb-field" HorizontalAlignment="Right"/>
              <ContentControl x:Name="floorheight" Grid.Row="1" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
              <TextBlock x:Name="label7" Text="Height offset:" Grid.Row="2" Classes="uldb-field" HorizontalAlignment="Right"/>
              <ContentControl x:Name="heightoffset" Grid.Row="2" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
              <TextBlock x:Name="sectorheightlabel" Grid.Row="3" Classes="uldb-field" HorizontalAlignment="Right"/>
              <TextBlock x:Name="sectorheight" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Ceiling" HorizontalAlignment="Center" Classes="uldb-field"/>
              <ContentControl x:Name="ceilingtex" Width="140" Height="150"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Floor" HorizontalAlignment="Center" Classes="uldb-field"/>
              <ContentControl x:Name="floortex" Width="140" Height="150"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="groupeffect" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupeffectTitle" Text="Effect and identification" Classes="uldb-group-title"/>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
            <TextBlock x:Name="label8" Text="Special:" Classes="uldb-field"/>
            <ContentControl x:Name="effect" Grid.Column="1"/>
            <Button x:Name="browseeffect" Grid.Column="2" Classes="uldb-tool"/>
          </Grid>
          <Grid ColumnDefinitions="Auto,92,*" ColumnSpacing="6">
            <TextBlock x:Name="label9" Text="Brightness:" Classes="uldb-field"/>
            <ContentControl x:Name="brightness" Grid.Column="1" Width="92"/>
          </Grid>
          <ContentControl x:Name="tagSelector"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
