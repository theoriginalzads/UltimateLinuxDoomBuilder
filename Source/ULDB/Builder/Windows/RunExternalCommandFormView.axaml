<!-- ULDB: the window of upstream's RunExternalCommandForm (model-ported: upstream's code runs unchanged):
     the command's output (errors in red) with Continue, Run again and Cancel. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.RunExternalCommandFormView"
        Title="Run external command" Width="800" Height="520" MinWidth="520" MinHeight="300" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="btnRetry" MinWidth="100" HorizontalContentAlignment="Center"/>
      <Button x:Name="btnContinue" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="btnCancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Border Classes="uldb-grid" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
      <ScrollViewer x:Name="outputscroll" HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="outputtext" Margin="6" FontFamily="monospace" FontSize="12"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
