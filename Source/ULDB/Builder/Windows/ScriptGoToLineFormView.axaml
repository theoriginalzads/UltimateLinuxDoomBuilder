<!-- ULDB: the window of upstream's ScriptGoToLineForm ("Go To Line", model-ported). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.ScriptGoToLineFormView"
        Title="Go To Line" Width="320" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="accept" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,92" ColumnSpacing="10">
      <TextBlock x:Name="label" Classes="uldb-field"/>
      <ContentControl x:Name="linenumber" Grid.Column="1" Width="92" HorizontalAlignment="Left"/>
    </Grid>
  </DockPanel>
</Window>
