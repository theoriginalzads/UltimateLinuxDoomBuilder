<!-- ULDB: the window of upstream's BitFlagsAndOptionsForm ("Options and flags", model-ported: upstream's code runs unchanged). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.BitFlagsAndOptionsFormView"
        Title="Options and flags" Width="320" Height="560" MinWidth="280" MinHeight="400" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <Border x:Name="groupoptions" Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Options" Classes="uldb-group-title"/><ContentControl x:Name="options"/></StackPanel></Border>
      <Border x:Name="groupflags" Grid.Row="1" Classes="uldb-group"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Flags" Classes="uldb-group-title" Margin="0,0,0,6"/><ScrollViewer><ContentControl x:Name="flags"/></ScrollViewer></DockPanel></Border>
    </Grid>
  </DockPanel>
</Window>
