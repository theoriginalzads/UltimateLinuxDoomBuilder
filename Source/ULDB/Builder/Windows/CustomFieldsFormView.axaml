<!-- ULDB: the window of upstream's CustomFieldsForm ("Custom fields", model-ported: upstream's code runs unchanged). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.CustomFieldsFormView"
        Title="Custom fields" Width="640" Height="460" MinWidth="520" MinHeight="340" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <ContentControl x:Name="fieldslist"/>
  </DockPanel>
</Window>
