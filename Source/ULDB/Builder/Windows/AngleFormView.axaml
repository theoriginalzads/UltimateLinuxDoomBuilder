<!-- ULDB: the window of upstream's AngleForm ("Angle", model-ported): pick one of eight directions. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.AngleFormView"
        Title="Angle" Width="260" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Right" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
      <Button x:Name="apply" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <ContentControl x:Name="angle" Width="84" Height="84" HorizontalAlignment="Left"/>
  </DockPanel>
</Window>
