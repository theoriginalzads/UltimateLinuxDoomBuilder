<!-- ULDB: the window for MapOptionsForm (Windows/MapOptionsForm.cs): the game configuration,
     map name, script type and resources of the open map (or a new one). Same controls and names
     as upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodeImp.DoomBuilder.Controls"
        x:Class="CodeImp.DoomBuilder.Windows.MapOptionsView"
        Title="Map Options" Width="560" Height="700" MinWidth="500" MinHeight="620"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="prepostcommands" Content="Edit pre and post commands..." Margin="0,0,16,0"/>
      <Button x:Name="apply" Content="OK" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" Content="Cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
      <TextBlock Text="Game Configuration:" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ComboBox x:Name="config" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"/>
      <TextBlock x:Name="scriptcompilerlabel" Grid.Row="1" Text="Script Type:" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ComboBox x:Name="scriptcompiler" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"/>
      <TextBlock Grid.Row="2" Text="Map Name:" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="levelname" Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" MaxLength="8"/>
      <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Opacity="0.7">
        <Run Text="e.g. "/><Run x:Name="examplelabel" Text="MAP01"/>
      </TextBlock>
      <HeaderedContentControl Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0" Header="Resources">
        <StackPanel Spacing="8">
          <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                     Text="Drag &amp; drop resources to add them. Drag items to change order (lower items override higher items). Use the context menu to cut, copy, paste or remove items."/>
          <controls:ResourceListEditorView x:Name="datalocations"/>
          <CheckBox x:Name="strictpatches" Content="Strictly load patches between P_START and P_END only for this file"/>
          <CheckBox x:Name="longtexturenames" Content="Use long texture names"/>
        </StackPanel>
      </HeaderedContentControl>
    </Grid>
  </DockPanel>
</Window>
