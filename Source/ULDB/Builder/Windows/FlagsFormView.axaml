<!-- ULDB: the window of upstream's FlagsForm ("Flags", model-ported: upstream's code runs unchanged). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.FlagsFormView"
        Title="Flags" Width="300" Height="420" MinWidth="260" MinHeight="300" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Border Classes="uldb-group"><ScrollViewer><ContentControl x:Name="flags"/></ScrollViewer></Border>
  </DockPanel>
</Window>
