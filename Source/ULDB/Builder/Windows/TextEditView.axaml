<!-- ULDB: the window of upstream's TextEditForm (model-ported): edits a text field's value. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.TextEditView"
        Title="Edit Text" Width="480" Height="280" MinWidth="320" MinHeight="180" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <TextBox x:Name="textbox" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
  </DockPanel>
</Window>
