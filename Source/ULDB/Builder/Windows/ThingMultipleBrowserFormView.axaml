<!-- ULDB: the window of upstream's ThingMultipleBrowserForm ("Choose Thing Types", model-ported). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.Windows.ThingMultipleBrowserFormView"
        Title="Choose Thing Types" Width="480" Height="640" MinWidth="400" MinHeight="460" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <ContentControl x:Name="thingslist"/>
  </DockPanel>
</Window>
