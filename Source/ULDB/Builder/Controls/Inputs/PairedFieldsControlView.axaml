<!-- ULDB: the view of upstream's PairedFieldsControl (model-ported): two linked UDMF fields (texture offsets, scales) with link and reset buttons.
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeImp.DoomBuilder.Controls.PairedFieldsControlView">
  <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="4">
    <ContentControl x:Name="value1"/>
    <ContentControl x:Name="value2" Grid.Column="1"/>
    <Button x:Name="bLink" Grid.Column="2" Classes="uldb-tool"/>
    <Button x:Name="bReset" Grid.Column="3" Classes="uldb-tool"/>
  </Grid>
</UserControl>
