<!-- ULDB: the view of upstream's TagSelector (model-ported): a tag: number or label, up/down, new/unused tag and clear.
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeImp.DoomBuilder.Controls.TagSelectorView">
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
    <TextBlock x:Name="label1" Classes="uldb-field"/>
    <ComboBox x:Name="cbTagPicker" Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360"/>
    <ContentControl x:Name="spin" Grid.Column="2"/>
    <Button x:Name="newTag" Grid.Column="3"/>
    <Button x:Name="unusedTag" Grid.Column="4"/>
    <Button x:Name="clear" Grid.Column="5" Classes="uldb-tool"/>
  </Grid>
</UserControl>
