<!-- ULDB: the view of upstream's VertexInfoPanel (Controls/VertexInfoPanel.cs, model-ported).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. Order and
     grouping follow upstream's designer; the look is ULDB's (cards, texture tiles). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uldb="clr-namespace:ULDB.Controls"
             x:Class="CodeImp.DoomBuilder.Controls.VertexInfoView">
  <Border x:Name="vertexinfo" Classes="uldb-card" HorizontalAlignment="Left">
    <StackPanel>
      <TextBlock x:Name="vertexinfoTitle" Classes="uldb-card-title"/>
      <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16,16">
        <TextBlock Text="Position:" Classes="uldb-key"/>
        <TextBlock x:Name="position" Grid.Column="1" Classes="uldb-value" MinWidth="120"/>
        <TextBlock x:Name="labelzceiling" Grid.Row="1" Classes="uldb-key"/>
        <TextBlock x:Name="zceiling" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
        <TextBlock x:Name="labelzfloor" Grid.Row="2" Classes="uldb-key"/>
        <TextBlock x:Name="zfloor" Grid.Row="2" Grid.Column="1" Classes="uldb-value"/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
