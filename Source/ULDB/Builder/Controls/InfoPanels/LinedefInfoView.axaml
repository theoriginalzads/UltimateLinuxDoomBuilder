<!-- ULDB: the view of upstream's LinedefInfoPanel (Controls/LinedefInfoPanel.cs, model-ported).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. Order and
     grouping follow upstream's designer; the look is ULDB's (cards, texture tiles). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ULDB.Shell"
             x:Class="CodeImp.DoomBuilder.Controls.LinedefInfoView">
  <StackPanel x:Name="flowLayoutPanel1" Orientation="Horizontal">
    <!-- Linedef properties and action arguments -->
    <Border x:Name="infopanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="infopanelTitle" Classes="uldb-card-title"/>
        <StackPanel Orientation="Horizontal">
          <Grid Width="320" ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="16,16,16,16,16">
            <TextBlock x:Name="actionlabel" Classes="uldb-key"/>
            <TextBlock x:Name="action" Grid.Column="1" Grid.ColumnSpan="3" Classes="uldb-value"/>
            <TextBlock x:Name="activationlabel" Grid.Row="1" Classes="uldb-key"/>
            <TextBlock x:Name="activation" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="uldb-value"/>
            <TextBlock x:Name="lengthlabel" Grid.Row="2" Classes="uldb-key"/>
            <TextBlock x:Name="length" Grid.Row="2" Grid.Column="1" Classes="uldb-value" MinWidth="44"/>
            <TextBlock x:Name="peglabel" Grid.Row="2" Grid.Column="2" Classes="uldb-key"/>
            <TextBlock x:Name="unpegged" Grid.Row="2" Grid.Column="3" Classes="uldb-value"/>
            <TextBlock x:Name="anglelabel" Grid.Row="3" Classes="uldb-key"/>
            <TextBlock x:Name="angle" Grid.Row="3" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="frontoffsetlabel" Grid.Row="3" Grid.Column="2" Classes="uldb-key"/>
            <TextBlock x:Name="frontoffset" Grid.Row="3" Grid.Column="3" Classes="uldb-value"/>
            <TextBlock x:Name="taglabel" Grid.Row="4" Classes="uldb-key"/>
            <TextBlock x:Name="tag" Grid.Row="4" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="backoffsetlabel" Grid.Row="4" Grid.Column="2" Classes="uldb-key"/>
            <TextBlock x:Name="backoffset" Grid.Row="4" Grid.Column="3" Classes="uldb-value"/>
          </Grid>
          <Grid x:Name="args" Width="230" ColumnDefinitions="Auto,*" RowDefinitions="16,16,16,16,16">
          <TextBlock x:Name="arglbl1" Grid.Row="0" Classes="uldb-key"/>
          <TextBlock x:Name="arg1" Grid.Row="0" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock x:Name="arglbl2" Grid.Row="1" Classes="uldb-key"/>
          <TextBlock x:Name="arg2" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock x:Name="arglbl3" Grid.Row="2" Classes="uldb-key"/>
          <TextBlock x:Name="arg3" Grid.Row="2" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock x:Name="arglbl4" Grid.Row="3" Classes="uldb-key"/>
          <TextBlock x:Name="arg4" Grid.Row="3" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock x:Name="arglbl5" Grid.Row="4" Classes="uldb-key"/>
          <TextBlock x:Name="arg5" Grid.Row="4" Grid.Column="1" Classes="uldb-value"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Front sidedef: upper, middle and lower textures -->
    <Border x:Name="frontpanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="frontpanelTitle" Classes="uldb-card-title"/>
        <StackPanel x:Name="flowLayoutPanelFront" Orientation="Horizontal">
          <StackPanel x:Name="panelFrontTop" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="fronthightexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="fronthightex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureFrontTop"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="fronthighname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="frontTopUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="frontTopUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="frontTopUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="frontTopUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="panelFrontMid" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="frontmidtexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="frontmidtex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureFrontMid"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="frontmidname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="frontMidUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="frontMidUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="frontMidUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="frontMidUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="panelFrontLow" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="frontlowtexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="frontlowtex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureFrontBottom"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="frontlowname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="frontBottomUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="frontBottomUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="frontBottomUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="frontBottomUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Back sidedef: upper, middle and lower textures -->
    <Border x:Name="backpanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="backpanelTitle" Classes="uldb-card-title"/>
        <StackPanel x:Name="flowLayoutPanelBack" Orientation="Horizontal">
          <StackPanel x:Name="panelBackTop" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="backhightexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="backhightex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureBackTop"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="backhighname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="backTopUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="backTopUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="backTopUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="backTopUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="panelBackMid" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="backmidtexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="backmidtex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureBackMid"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="backmidname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="backMidUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="backMidUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="backMidUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="backMidUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="panelBackLow" Orientation="Horizontal" Margin="0,0,10,0">
            <StackPanel Width="64">
              <Border x:Name="backlowtexTile" Classes="uldb-tile">
                <Panel>
                  <Image x:Name="backlowtex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                  <Border Classes="uldb-badge"><TextBlock x:Name="labelTextureBackBottom"/></Border>
                </Panel>
              </Border>
              <TextBlock x:Name="backlowname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16" VerticalAlignment="Top" Margin="6,0,0,0">
              <TextBlock x:Name="backBottomUDMFOffsetLabel" Classes="uldb-key"/>
              <TextBlock x:Name="backBottomUDMFOffset" Grid.Column="1" Classes="uldb-value"/>
              <TextBlock x:Name="backBottomUDMFScaleLabel" Grid.Row="1" Classes="uldb-key"/>
              <TextBlock x:Name="backBottomUDMFScale" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Flags (and UDMF activations, highlighted) -->
    <Border x:Name="flagsPanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="flagsPanelTitle" Classes="uldb-card-title"/>
        <ItemsControl x:Name="flags" ItemTemplate="{StaticResource UldbFlagTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="80"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
