<!-- ULDB: the view of upstream's SectorInfoPanel (Controls/SectorInfoPanel.cs, model-ported).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. Order and
     grouping follow upstream's designer; the look is ULDB's (cards, texture tiles). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uldb="clr-namespace:ULDB.Controls"
             x:Class="CodeImp.DoomBuilder.Controls.SectorInfoView">
  <StackPanel x:Name="flowLayoutPanel1" Orientation="Horizontal">
    <!-- Sector properties -->
    <Border x:Name="sectorinfo" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="sectorinfoTitle" Classes="uldb-card-title"/>
        <Grid Width="290" ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="16,16,16,16,16">
          <TextBlock x:Name="effectlabel" Classes="uldb-key"/>
          <TextBlock x:Name="effect" Grid.Column="1" Grid.ColumnSpan="3" Classes="uldb-value"/>
          <TextBlock x:Name="labelceiling" Grid.Row="1" Classes="uldb-key"/>
          <TextBlock x:Name="ceiling" Grid.Row="1" Grid.Column="1" Classes="uldb-value" MinWidth="44"/>
          <TextBlock x:Name="labelLight" Grid.Row="1" Grid.Column="2" Classes="uldb-key"/>
          <Border x:Name="panelLightColor" Grid.Row="1" Grid.Column="3" Classes="uldb-swatch" Width="28" Height="11" CornerRadius="2" HorizontalAlignment="Left"/>
          <TextBlock x:Name="labelfloor" Grid.Row="2" Classes="uldb-key"/>
          <TextBlock x:Name="floor" Grid.Row="2" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock x:Name="labelFade" Grid.Row="2" Grid.Column="2" Classes="uldb-key"/>
          <Border x:Name="panelFadeColor" Grid.Row="2" Grid.Column="3" Classes="uldb-swatch" Width="28" Height="11" CornerRadius="2" HorizontalAlignment="Left"/>
          <TextBlock Text="Height:" Grid.Row="3" Classes="uldb-key"/>
          <TextBlock x:Name="height" Grid.Row="3" Grid.Column="1" Classes="uldb-value"/>
          <TextBlock Text="Brightness:" Grid.Row="3" Grid.Column="2" Classes="uldb-key"/>
          <TextBlock x:Name="brightness" Grid.Row="3" Grid.Column="3" Classes="uldb-value"/>
          <TextBlock x:Name="taglabel" Grid.Row="4" Classes="uldb-key"/>
          <TextBlock x:Name="tag" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Classes="uldb-value"/>
        </Grid>
      </StackPanel>
    </Border>
    <!-- Floor -->
    <Border x:Name="floorpanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="floorpanelTitle" Classes="uldb-card-title"/>
        <StackPanel Orientation="Horizontal">
          <StackPanel Width="64">
            <Border Classes="uldb-tile">
              <Panel>
                <Image x:Name="floortex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                <Border Classes="uldb-badge"><TextBlock x:Name="labelFloorTextureSize"/></Border>
              </Panel>
            </Border>
            <TextBlock x:Name="floorname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16,16,16" VerticalAlignment="Top" Margin="8,0,0,0">
            <TextBlock x:Name="floorOffsetLabel" Classes="uldb-key"/>
            <TextBlock x:Name="floorOffset" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="floorAngleLabel" Grid.Row="1" Classes="uldb-key"/>
            <TextBlock x:Name="floorAngle" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="floorScaleLabel" Grid.Row="2" Classes="uldb-key"/>
            <TextBlock x:Name="floorScale" Grid.Row="2" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="floorLightLabel" Grid.Row="3" Classes="uldb-key"/>
            <TextBlock x:Name="floorLight" Grid.Row="3" Grid.Column="1" Classes="uldb-value"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Ceiling -->
    <Border x:Name="ceilingpanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="ceilingpanelTitle" Classes="uldb-card-title"/>
        <StackPanel Orientation="Horizontal">
          <StackPanel Width="64">
            <Border Classes="uldb-tile">
              <Panel>
                <Image x:Name="ceilingtex" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                <Border Classes="uldb-badge"><TextBlock x:Name="labelCeilTextureSize"/></Border>
              </Panel>
            </Border>
            <TextBlock x:Name="ceilingname" Classes="uldb-small" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="16,16,16,16" VerticalAlignment="Top" Margin="8,0,0,0">
            <TextBlock x:Name="ceilingOffsetLabel" Classes="uldb-key"/>
            <TextBlock x:Name="ceilingOffset" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="ceilingAngleLabel" Grid.Row="1" Classes="uldb-key"/>
            <TextBlock x:Name="ceilingAngle" Grid.Row="1" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="ceilingScaleLabel" Grid.Row="2" Classes="uldb-key"/>
            <TextBlock x:Name="ceilingScale" Grid.Row="2" Grid.Column="1" Classes="uldb-value"/>
            <TextBlock x:Name="ceilingLightLabel" Grid.Row="3" Classes="uldb-key"/>
            <TextBlock x:Name="ceilingLight" Grid.Row="3" Grid.Column="1" Classes="uldb-value"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Flags -->
    <Border x:Name="flagsPanel" Classes="uldb-card">
      <StackPanel>
        <TextBlock x:Name="flagsPanelTitle" Classes="uldb-card-title"/>
        <ItemsControl x:Name="flags" ItemTemplate="{StaticResource UldbFlagTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="80"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
