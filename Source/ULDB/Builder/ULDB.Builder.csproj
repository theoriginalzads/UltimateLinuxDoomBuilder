  <!-- Data files next to the program, laid out like upstream's Build folder
       (Configurations/, Compilers/, Scripting/, UDBuilder.default.cfg, ...).
       Windows-only DLLs and the .chm help file are left out. -->
  <PropertyGroup>
    <UpstreamAssets>$(MSBuildThisFileDirectory)../../../Assets/</UpstreamAssets>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(UpstreamAssets)Common/**/*"
          Exclude="$(UpstreamAssets)Common/*.dll;$(UpstreamAssets)Common/*.pdb;$(UpstreamAssets)Common/*.xml;$(UpstreamAssets)Common/*.chm;$(UpstreamAssets)Common/Plugins/**"
          Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The Plugins folder and its load order; the plugins themselves are built from Phase 4 on.
         Jint/Esprima (Plugins/Dependencies) are only used by UDBScript, which is out of scope. -->
    <None Include="$(UpstreamAssets)Common/Plugins/Loadorder.cfg" Link="Plugins/Loadorder.cfg" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Upstream's prebuilt Linux ACC and ZDBSP are replaced by source builds (tools/compilers). -->
    <None Include="$(UpstreamAssets)Linux/**/*"
          Exclude="$(UpstreamAssets)Linux/Compilers/*/acc;$(UpstreamAssets)Linux/Compilers/Nodebuilders/zdbsp"
          Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- BCS support: upstream only ships it for Windows. ZT-BCC's libraries and the syntax
         definitions are platform-neutral text; the compiler configs are ULDB's Linux versions
         (Source/ULDB/Assets). -->
    <!-- BCC: its own library files, matching the source-built compiler. Upstream's BCC
         std.acs/zcommon.bcs use a syntax no BCC release accepts. -->
    <None Include="$(MSBuildThisFileDirectory)../../../tools/compilers/src/bcc/lib/**/*"
          Link="Compilers/BCC/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UpstreamAssets)Windows/Compilers/ZT-BCC/**/*" Exclude="$(UpstreamAssets)Windows/Compilers/ZT-BCC/*.exe;$(UpstreamAssets)Windows/Compilers/ZT-BCC/*.cfg"
          Link="Compilers/ZT-BCC/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UpstreamAssets)Windows/Scripting/*.cfg" Exclude="$(UpstreamAssets)Windows/Scripting/BCS.cfg" Link="Scripting/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../Assets/**/*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Native renderer (libBuilderNative.so), built with CMake from upstream's Source/Native
       plus Source/ULDB/Native. CPU target: dotnet build -p:UldbArch=znver4 (default generic). -->
  <PropertyGroup>
    <UldbArch Condition="'$(UldbArch)' == ''">generic</UldbArch>
    <NativeSourceDir>$(MSBuildThisFileDirectory)../Native</NativeSourceDir>
    <NativeBuildDir>$(MSBuildThisFileDirectory)obj/native/$(Configuration)-$(UldbArch)</NativeBuildDir>
    <NativeBuildType Condition="'$(Configuration)' == 'Debug'">RelWithDebInfo</NativeBuildType>
    <NativeBuildType Condition="'$(Configuration)' != 'Debug'">Release</NativeBuildType>
  </PropertyGroup>
  <Target Name="BuildNative" BeforeTargets="AssignTargetPaths" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="cmake -S &quot;$(NativeSourceDir)&quot; -B &quot;$(NativeBuildDir)&quot; -G Ninja -DCMAKE_BUILD_TYPE=$(NativeBuildType) -DUDB_ARCH=$(UldbArch) &gt; /dev/null" />
    <Exec Command="cmake --build &quot;$(NativeBuildDir)&quot;" />
    <ItemGroup>
      <None Include="$(NativeBuildDir)/libBuilderNative.so" Link="libBuilderNative.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(NativeBuildDir)/libuser32.so" Link="libuser32.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
  <!-- Script compilers and node builder, built from source (tools/compilers, git submodules). -->
  <PropertyGroup>
    <CompilersSourceDir>$(MSBuildThisFileDirectory)../../../tools/compilers</CompilersSourceDir>
    <CompilersBuildDir>$(MSBuildThisFileDirectory)obj/compilers/$(UldbArch)</CompilersBuildDir>
  </PropertyGroup>
  <Target Name="BuildCompilers" BeforeTargets="AssignTargetPaths" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="cmake -S &quot;$(CompilersSourceDir)&quot; -B &quot;$(CompilersBuildDir)&quot; -G Ninja -DUDB_ARCH=$(UldbArch) &gt; /dev/null" />
    <!-- Quiet unless it fails: then its error lines and the end of the build log are shown. -->
    <Exec Command="cmake --build &quot;$(CompilersBuildDir)&quot; &gt; &quot;$(CompilersBuildDir)/build.log&quot; 2&gt;&amp;1 || (grep -E -B12 &quot;error:|Error [0-9]|undefined reference|collect2&quot; &quot;$(CompilersBuildDir)/build.log&quot; | head -n 60; tail -n 20 &quot;$(CompilersBuildDir)/build.log&quot;; exit 1)" StandardOutputImportance="high" />
    <ItemGroup>
      <None Include="$(CompilersBuildDir)/bin/acc" Link="Compilers/ZDoom/acc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/acc" Link="Compilers/Zandronum/acc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/acc" Link="Compilers/ZDaemon/acc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/acc" Link="Compilers/Hexen/acc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/zdbsp" Link="Compilers/Nodebuilders/zdbsp" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/zt-bcc" Link="Compilers/ZT-BCC/zt-bcc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(CompilersBuildDir)/bin/bcc" Link="Compilers/BCC/bcc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
