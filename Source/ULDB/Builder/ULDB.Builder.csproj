<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Builder assembly: upstream Source/Core files plus ULDB's UI layer.
       Upstream files are included by glob and never moved or edited for the
       project structure; WinForms UI (Controls/, Windows/) is excluded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Builder</AssemblyName>
    <!-- An executable like upstream's Builder.exe. Upstream's General.Main is also a Main,
         so name the entry point: ULDB's sets up Avalonia, then calls General.Main. -->
    <OutputType>Exe</OutputType>
    <StartupObject>ULDB.Shell.Program</StartupObject>
    <RootNamespace>CodeImp.DoomBuilder</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Upstream code is C# 13 or older. C# 14 (the .NET 10 default) makes `field` a keyword inside
         property accessors, which silently changes upstream properties that use a member named
         `field` (ColorFieldsControl.Field). -->
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NO_SCINTILLA;NO_FORMS_DESIGN;NO_WIN32;NO_UPDATER;ULDB;MONO_WINFORMS</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0108;CS0162;CS0219;CS0168</NoWarn>
    <!-- Form resources (FormResources/, tools/resxgen/formresx.py) hold Bitmap/Icon file
         references, created from a stream at runtime by System.Resources.Extensions. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup>
    <UpstreamCore>$(MSBuildThisFileDirectory)../../Core/</UpstreamCore>
  </PropertyGroup>
