<!-- ULDB: the view of Tag Explorer's docker control (model-ported: upstream's TagExplorer.cs runs
     unchanged). Controls named like upstream's fields are bound to them by ModelBinder.BindByName:
     display and sort options and the filter on top, the tree below, export at the bottom. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeImp.DoomBuilder.TagExplorer.TagExplorerView">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="4">
        <TextBlock x:Name="label1" Classes="uldb-field" HorizontalAlignment="Right"/>
        <ComboBox x:Name="cbDisplayMode" Grid.Column="1" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="labelsortmode" Grid.Row="1" Classes="uldb-field" HorizontalAlignment="Right"/>
        <ComboBox x:Name="cbSortMode" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="labelSearch" Grid.Row="2" Classes="uldb-field" HorizontalAlignment="Right"/>
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBox x:Name="tbSearch"/>
          <Button x:Name="btnClearSearch" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <CheckBox x:Name="cbCenterOnSelected"/>
      <CheckBox x:Name="cbSelectOnClick"/>
      <CheckBox x:Name="cbCommentsOnly"/>
    </StackPanel>
    <Button x:Name="bExportToFile" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
    <ContentControl x:Name="treeView"/>
  </DockPanel>
</UserControl>
