<Project Sdk="Microsoft.NET.Sdk">
  <!-- The TagExplorer plugin (the Tag Explorer docker): upstream's Source/Plugins/TagExplorer,
       included by glob. Its WinForms UI (Controls) is replaced by generated placeholders
       until ported (tools/uistubgen/prune.py TagExplorer). Same setup as ULDB.BuilderModes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TagExplorer</AssemblyName>
    <RootNamespace>CodeImp.DoomBuilder.TagExplorer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Upstream code is C# 13 or older (docs/architecture.md, "Language version"). -->
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NO_SCINTILLA;NO_FORMS_DESIGN;NO_WIN32;NO_UPDATER;ULDB;MONO_WINFORMS</DefineConstants>
    <!-- The control's .resx (FormResources/, tools/resxgen/formresx.py): its ImageList can't be read on Linux. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0108;CS0162;CS0219;CS0168</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <UpstreamPlugin>$(MSBuildThisFileDirectory)../../../Plugins/TagExplorer/</UpstreamPlugin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamPlugin)**/*.cs"
             Exclude="$(UpstreamPlugin)obj/**;$(UpstreamPlugin)bin/**;$(UpstreamPlugin)Properties/Resources.Designer.cs;$(UpstreamPlugin)Controls/**" />
    <!-- Model port (uistubs-ported.txt): the docker's control compiles unchanged; its Avalonia view is in Views/. -->
    <Compile Include="$(UpstreamPlugin)Controls/TagExplorer.cs;$(UpstreamPlugin)Controls/TagExplorer.Designer.cs" />
    <Compile Include="Properties/**/*.cs" />
    <!-- ULDB's Avalonia views for model-ported controls (.axaml), registered by PluginViews. -->
    <Compile Include="Views/**/*.cs" />
    <Compile Include="UIStubs/**/*.cs" />
    <Compile Include="UIStubFixes/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded by the plugin host at runtime from Builder's folder, so not copied here. -->
    <ProjectReference Include="../../Builder/ULDB.Builder.csproj" Private="false" />
    <ProjectReference Include="../../Compat/ULDB.Compat.csproj" Private="false" />
  </ItemGroup>
  <!-- Upstream's embedded resources under the names upstream uses; Plugin.GetResourceStream finds them by suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="$(UpstreamPlugin)Resources/*.png"
                      LogicalName="CodeImp.DoomBuilder.TagExplorer.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="10.0.13" />
    <EmbeddedResource Update="FormResources/TagExplorer.resx" LogicalName="CodeImp.DoomBuilder.TagExplorer.TagExplorer.resources" />
    <!-- Same Avalonia as Builder (loaded from Builder's folder at runtime); compiles the views' .axaml. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>
  <Import Project="Properties/Resources.g.props" />
  <!-- Into Builder's Plugins folder, like upstream's Build/Plugins. -->
  <Target Name="CopyToBuilderPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildThisFileDirectory)../../Builder/bin/$(Configuration)/net10.0/Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
