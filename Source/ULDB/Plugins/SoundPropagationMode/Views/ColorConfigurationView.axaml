<!-- ULDB: the window of Sound Propagation mode's ColorConfiguration (model-ported: upstream's code runs unchanged). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.SoundPropagationMode.ColorConfigurationView"
        Title="Sound propagation colors" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="resetcolors" MinWidth="110" HorizontalContentAlignment="Center"/>
      <Button x:Name="okbutton" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancelbutton" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8">
      <ContentControl x:Name="highlightcolor"/>
      <ContentControl x:Name="level1color"/>
      <ContentControl x:Name="level2color"/>
      <ContentControl x:Name="nosoundcolor"/>
      <ContentControl x:Name="blocksoundcolor"/>
    </StackPanel>
  </DockPanel>
</Window>
