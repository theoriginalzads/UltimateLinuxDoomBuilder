<!-- ULDB: the view of BuilderModes' Undo/Redo docker (model-ported: upstream's UndoRedoPanel.cs runs
     unchanged). Picking an entry undoes or redoes to it; entries that would become redo levels are
     greyed, as upstream. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:ULDB.Shell"
             x:Class="CodeImp.DoomBuilder.BuilderModes.UndoRedoPanelView">
  <Border Classes="uldb-grid" BorderThickness="1" CornerRadius="3" ClipToBounds="True" Margin="4">
    <ListBox x:Name="list" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="shell:ModelBinder+ListItem">
          <Border Classes="level" Classes.current="{Binding Highlight}" Padding="8,2">
            <TextBlock Text="{Binding Text}" Classes.dim="{Binding Dim}" TextTrimming="CharacterEllipsis" FontSize="12"/>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Border>
  <UserControl.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <!-- Compact rows; upstream colours the current level and the level being picked (its Highlight colour). -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UldbHoverBrush}"/>
    </Style>
    <Style Selector="Border.level.current">
      <Setter Property="Background" Value="{DynamicResource UldbCheckedBrush}"/>
    </Style>
  </UserControl.Styles>
</UserControl>
