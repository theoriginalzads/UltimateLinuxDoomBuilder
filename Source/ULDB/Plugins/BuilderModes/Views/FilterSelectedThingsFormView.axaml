<!-- ULDB: the window of BuilderModes' FilterSelectedThingsForm (model-ported: upstream's code runs unchanged).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName; the thing types list is upstream's grid. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.BuilderModes.FilterSelectedThingsFormView"
        Title="Filter Selected Things" Width="440" Height="360" MinWidth="360" MinHeight="260" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <DockPanel>
      <TextBlock x:Name="textBox1" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ContentControl x:Name="dataGridView"/>
    </DockPanel>
  </DockPanel>
</Window>
