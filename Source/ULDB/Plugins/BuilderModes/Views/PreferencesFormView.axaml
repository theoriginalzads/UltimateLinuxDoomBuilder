<!-- ULDB: Builder Modes' "Editing" tab in the Preferences dialog (model-ported: upstream's
     PreferencesForm runs unchanged; its tab page is shown by ULDB.Shell.TabPageViews).
     Written by a one-off script from the designer's field list; labels not bound upstream live here. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeImp.DoomBuilder.BuilderModes.PreferencesFormView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,10,10,0" Spacing="10">
      <Border Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Options" Classes="uldb-group-title"/><CheckBox x:Name="additiveselect" Classes="uldb-flag"/><CheckBox x:Name="additivepaintselect" Classes="uldb-flag"/><CheckBox x:Name="autoclearselection" Classes="uldb-flag"/><CheckBox x:Name="visualmodeclearselection" Classes="uldb-flag"/><CheckBox x:Name="editnewthing" Classes="uldb-flag"/><CheckBox x:Name="editnewsector" Classes="uldb-flag"/><CheckBox x:Name="autodrawonedit" Classes="uldb-flag"/><CheckBox x:Name="syncSelection" Classes="uldb-flag"/><CheckBox x:Name="switchviewmodes" Classes="uldb-flag"/><CheckBox x:Name="selectafterundoredo" Classes="uldb-flag"/><CheckBox x:Name="useoppositesmartpivothandle" Classes="uldb-flag"/><CheckBox x:Name="dontMoveGeometryOutsideBounds" Classes="uldb-flag"/><CheckBox x:Name="autoaligntexturesoncreate" Classes="uldb-flag"/><CheckBox x:Name="autodragonpaste" Classes="uldb-flag"/><CheckBox x:Name="usebuggyfloodselect" Classes="uldb-flag"/></StackPanel></Border>
      <Border Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Ranges" Classes="uldb-group-title"/><Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Highlight geometry within:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="highlightrange" Width="92" HorizontalAlignment="Left"/><TextBlock Text="pixels" Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="1" Text="Highlight things within:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="highlightthingsrange" Width="92" HorizontalAlignment="Left"/><TextBlock Text="pixels" Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="2" Text="Stitch geometry within:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="stitchrange" Width="92" HorizontalAlignment="Left"/><TextBlock Text="pixels" Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="3" Text="Split linedefs within:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="splitlinedefsrange" Width="92" HorizontalAlignment="Left"/><TextBlock Text="pixels" Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="4" Text="Mouse selection threshold:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="mouseselectionthreshold" Width="92" HorizontalAlignment="Left"/><TextBlock Text="pixels" Classes="uldb-field"/></StackPanel></Grid></StackPanel></Border>
      <Border Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Behavior" Classes="uldb-group-title"/><Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="When sector height changes are used on a wall in Visual Mode:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="heightbysidedef" Width="300"/></StackPanel><TextBlock Grid.Row="1" Text="When splitting a linedef:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="splitbehavior" Width="300"/></StackPanel><TextBlock Grid.Row="2" Text="When auto-aligning textures on slopes:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="scaletexturesonslopes" Width="300"/></StackPanel></Grid></StackPanel></Border>
      <Border Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Event line labels" Classes="uldb-group-title"/><Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Visibility:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="eventlinelabelvisibility" Width="220"/></StackPanel><TextBlock Grid.Row="1" Text="Style:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="eventlinelabelstyle" Width="260"/></StackPanel></Grid></StackPanel></Border>
      <Border Classes="uldb-group"><StackPanel Spacing="6"><TextBlock Text="Default sector settings" Classes="uldb-group-title"/><Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Default floor height:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="defaultfloorheight" Width="92" HorizontalAlignment="Left"/><TextBlock Text="m.u." Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="1" Text="Default ceiling height:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="defaultceilheight" Width="92" HorizontalAlignment="Left"/><TextBlock Text="m.u." Classes="uldb-field"/></StackPanel><TextBlock Grid.Row="2" Text="Default brightness:" Classes="uldb-field" HorizontalAlignment="Right"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"><ContentControl x:Name="defaultbrightness" Width="92" HorizontalAlignment="Left"/></StackPanel></Grid></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
