<!-- ULDB: the window of BuilderModes' MakeDoorForm (model-ported: upstream's code runs unchanged).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName; the four textures sit side by side as upstream. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.BuilderModes.Interface.MakeDoorFormView"
        Title="Make Door" Width="470" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="10">
      <UniformGrid Columns="4" ColumnSpacing="8">
        <StackPanel Spacing="4"><TextBlock x:Name="label1" Text="Door" FontWeight="SemiBold"/><ContentControl x:Name="doortexture" Height="104"/></StackPanel>
        <StackPanel Spacing="4"><TextBlock x:Name="label4" Text="Track" FontWeight="SemiBold"/><ContentControl x:Name="tracktexture" Height="104"/></StackPanel>
        <StackPanel Spacing="4"><TextBlock x:Name="label2" Text="Ceiling" FontWeight="SemiBold"/><ContentControl x:Name="ceilingtexture" Height="104"/></StackPanel>
        <StackPanel Spacing="4"><TextBlock x:Name="label3" Text="Floor" FontWeight="SemiBold"/><ContentControl x:Name="floortexture" Height="104"/></StackPanel>
      </UniformGrid>
      <WrapPanel>
        <CheckBox x:Name="resetoffsets" Margin="0,0,16,0"/>
        <CheckBox x:Name="applyactionspecials" Margin="0,0,16,0"/>
        <CheckBox x:Name="applytag"/>
      </WrapPanel>
    </StackPanel>
  </DockPanel>
</Window>
