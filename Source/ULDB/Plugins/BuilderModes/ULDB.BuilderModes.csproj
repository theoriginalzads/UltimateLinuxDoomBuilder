<Project Sdk="Microsoft.NET.Sdk">
  <!-- The BuilderModes plugin (classic and visual editing modes): upstream's
       Source/Plugins/BuilderModes, included by glob. Its WinForms UI (Interface/) is
       replaced by generated placeholders until ported (tools/uistubgen/prune.py BuilderModes). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BuilderModes</AssemblyName>
    <RootNamespace>CodeImp.DoomBuilder.BuilderModes</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Upstream code is C# 13 or older. C# 14 (the .NET 10 default) makes `field` a keyword inside
         property accessors, which silently changes upstream properties that use a member named
         `field` (ColorFieldsControl.Field). -->
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NO_SCINTILLA;NO_FORMS_DESIGN;NO_WIN32;NO_UPDATER;ULDB;MONO_WINFORMS</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0108;CS0162;CS0219;CS0168</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <UpstreamPlugin>$(MSBuildThisFileDirectory)../../../Plugins/BuilderModes/</UpstreamPlugin>
  </PropertyGroup>
  <ItemGroup>
    <!-- BlockMapMode and TriangulatorMode are on disk but not in upstream's build. -->
    <Compile Include="$(UpstreamPlugin)**/*.cs"
             Exclude="$(UpstreamPlugin)obj/**;$(UpstreamPlugin)bin/**;$(UpstreamPlugin)Interface/**;$(UpstreamPlugin)Properties/Resources.Designer.cs;$(UpstreamPlugin)ClassicModes/BlockMapMode.cs;$(UpstreamPlugin)ClassicModes/TriangulatorMode.cs" />
    <!-- Interface types that compile unchanged against ULDB.Compat (see uistubs-ported.txt).
         MenusForm is never shown: it only holds the plugin's menu items and toolbar buttons. -->
    <Compile Include="$(UpstreamPlugin)Interface/MenusForm.cs;$(UpstreamPlugin)Interface/MenusForm.Designer.cs" />
    <!-- Model ports with Avalonia views in Views/: the Undo/Redo docker. -->
    <Compile Include="$(UpstreamPlugin)Interface/UndoRedoPanel.cs;$(UpstreamPlugin)Interface/UndoRedoPanel.Designer.cs" />
    <Compile Include="Properties/**/*.cs" />
    <!-- ULDB's Avalonia views for model-ported UI (.axaml), registered by PluginViews. -->
    <Compile Include="Views/**/*.cs" />
    <Compile Include="UIStubs/**/*.cs" />
    <Compile Include="UIStubFixes/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded by the plugin host at runtime from Builder's folder, so not copied here. -->
    <ProjectReference Include="../../Builder/ULDB.Builder.csproj" Private="false" />
    <ProjectReference Include="../../Compat/ULDB.Compat.csproj" Private="false" />
  </ItemGroup>
  <!-- Upstream's embedded resources (Actions.cfg, mode icons, ...), under the names upstream
       uses; Plugin.GetResourceStream finds them by suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="$(UpstreamPlugin)Resources/*.cfg;$(UpstreamPlugin)Resources/*.png;$(UpstreamPlugin)Resources/*.txt"
                      LogicalName="CodeImp.DoomBuilder.BuilderModes.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- MenusForm's designer reads a tooltip through ComponentResourceManager (strings only). -->
    <EmbeddedResource Include="$(UpstreamPlugin)Interface/MenusForm.resx" LogicalName="CodeImp.DoomBuilder.BuilderModes.MenusForm.resources" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same Avalonia as Builder (loaded from Builder's folder at runtime); compiles the views' .axaml. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>
  <Import Project="Properties/Resources.g.props" />
  <!-- Into Builder's Plugins folder, like upstream's Build/Plugins. -->
  <Target Name="CopyToBuilderPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildThisFileDirectory)../../Builder/bin/$(Configuration)/net10.0/Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
