<!-- ULDB: the window of BuilderEffects' DirectionalShadingForm (model-ported: upstream's code runs unchanged).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName; groups and
     their order follow upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.BuilderEffects.DirectionalShadingFormView"
        Title="Directional Shading" Width="520" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="apply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Grid.IsSharedSizeScope="True">
      <Border x:Name="groupBox1" Grid.RowSpan="2" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupBox1Title" Classes="uldb-group-title"/>
          <ContentControl x:Name="sunangle" Width="90" Height="90"/>
          <ContentControl x:Name="sunangletb" Width="92"/>
        </StackPanel>
      </Border>
      <Border x:Name="groupBox2" Grid.Column="1" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupBox2Title" Classes="uldb-group-title"/>
          <ContentControl x:Name="lightamount"/>
          <ContentControl x:Name="lightcolor"/>
        </StackPanel>
      </Border>
      <Border x:Name="groupBox3" Grid.Row="1" Grid.Column="1" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupBox3Title" Classes="uldb-group-title"/>
          <ContentControl x:Name="shadeamount"/>
          <ContentControl x:Name="shadecolor"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
