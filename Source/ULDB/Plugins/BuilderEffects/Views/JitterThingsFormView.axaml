<!-- ULDB: the window of BuilderEffects' JitterThingsForm (model-ported: upstream's code runs unchanged).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName; groups and
     their order follow upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.BuilderEffects.JitterThingsFormView"
        Title="Randomize Things!" Width="500" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="bApply" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="bCancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
      <Border x:Name="groupBox1" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupBox1Title" Classes="uldb-group-title"/>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4">
            <ContentControl x:Name="positionJitterAmmount"/>
            <Button x:Name="bUpdateTranslation" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
            <ContentControl x:Name="heightJitterAmmount" Grid.Row="1"/>
            <Button x:Name="bUpdateHeight" Grid.Row="1" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border x:Name="groupBox2" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="groupBox2Title" Classes="uldb-group-title"/>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="4">
            <ContentControl x:Name="rotationJitterAmmount"/>
            <Button x:Name="bUpdateAngle" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
            <ContentControl x:Name="pitchAmmount" Grid.Row="1"/>
            <Button x:Name="bUpdatePitch" Grid.Row="1" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
            <ContentControl x:Name="rollAmmount" Grid.Row="2"/>
            <Button x:Name="bUpdateRoll" Grid.Row="2" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
          </Grid>
          <UniformGrid Columns="2">
            <CheckBox x:Name="cbRelativePitch"/>
            <CheckBox x:Name="cbNegativePitch"/>
            <CheckBox x:Name="cbRelativeRoll"/>
            <CheckBox x:Name="cbNegativeRoll"/>
          </UniformGrid>
        </StackPanel>
      </Border>
      <Border x:Name="scalegroup" Classes="uldb-group">
        <StackPanel Spacing="6">
          <TextBlock x:Name="scalegroupTitle" Classes="uldb-group-title"/>
          <Grid RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="uldblabel"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="label2" Classes="uldb-field" HorizontalAlignment="Right"/>
            <NumericUpDown x:Name="minScaleX" Grid.Column="1"/>
            <TextBlock x:Name="label3" Grid.Column="2" Classes="uldb-field"/>
            <NumericUpDown x:Name="maxScaleX" Grid.Column="3"/>
            <Button x:Name="bUpdateScaleX" Grid.Column="5" Classes="uldb-tool" VerticalAlignment="Center"/>
            <TextBlock x:Name="minScaleYLabel" Grid.Row="1" Classes="uldb-field" HorizontalAlignment="Right"/>
            <NumericUpDown x:Name="minScaleY" Grid.Row="1" Grid.Column="1"/>
            <TextBlock x:Name="maxScaleYLabel" Grid.Row="1" Grid.Column="2" Classes="uldb-field"/>
            <NumericUpDown x:Name="maxScaleY" Grid.Row="1" Grid.Column="3"/>
            <Button x:Name="bUpdateScaleY" Grid.Row="1" Grid.Column="5" Classes="uldb-tool" VerticalAlignment="Center"/>
          </Grid>
          <UniformGrid Columns="2">
            <CheckBox x:Name="cbRelativeScale"/>
            <CheckBox x:Name="cbNegativeScaleX"/>
            <CheckBox x:Name="cbUniformScale"/>
            <CheckBox x:Name="cbNegativeScaleY"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
