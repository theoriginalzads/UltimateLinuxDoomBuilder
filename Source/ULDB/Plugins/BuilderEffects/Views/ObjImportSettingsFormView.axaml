<!-- ULDB: the window of BuilderEffects' ObjImportSettingsForm (model-ported: upstream's code runs unchanged).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName; groups and
     their order follow upstream's designer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.BuilderEffects.ObjImportSettingsFormView"
        Title="Import Wavefront .obj" Width="460" SizeToContent="Height" CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="import" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancel" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </StackPanel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="6">
      <TextBlock x:Name="label1" Classes="uldb-field" HorizontalAlignment="Right"/>
      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
        <TextBox x:Name="tbImportPath"/>
        <Button x:Name="browse" Grid.Column="1" Classes="uldb-tool" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock x:Name="label2" Grid.Row="1" Classes="uldb-field" HorizontalAlignment="Right"/>
      <NumericUpDown x:Name="nudScale" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left"/>
      <TextBlock x:Name="label3" Grid.Row="2" Classes="uldb-field" HorizontalAlignment="Right"/>
      <StackPanel x:Name="panel1" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <RadioButton x:Name="axisx" GroupName="axis"/>
        <RadioButton x:Name="axisy" GroupName="axis"/>
        <RadioButton x:Name="axisz" GroupName="axis"/>
      </StackPanel>
      <CheckBox x:Name="cbusevertexheight" Grid.Row="3" Grid.Column="1"/>
    </Grid>
  </DockPanel>
</Window>
