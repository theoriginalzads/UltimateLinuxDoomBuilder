<Project Sdk="Microsoft.NET.Sdk">
  <!-- The BuilderEffects plugin (jitter, directional shading, OBJ terrain import): upstream's Source/Plugins/BuilderEffects,
       included by glob. Its WinForms UI (Controls, Interface) is replaced by generated placeholders
       until ported (tools/uistubgen/prune.py BuilderEffects). Same setup as ULDB.BuilderModes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BuilderEffects</AssemblyName>
    <RootNamespace>CodeImp.DoomBuilder.BuilderEffects</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Upstream code is C# 13 or older (docs/architecture.md, "Language version"). -->
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NO_SCINTILLA;NO_FORMS_DESIGN;NO_WIN32;NO_UPDATER;ULDB;MONO_WINFORMS</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0108;CS0162;CS0219;CS0168</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <UpstreamPlugin>$(MSBuildThisFileDirectory)../../../Plugins/BuilderEffects/</UpstreamPlugin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamPlugin)**/*.cs"
             Exclude="$(UpstreamPlugin)obj/**;$(UpstreamPlugin)bin/**;$(UpstreamPlugin)Properties/Resources.Designer.cs;$(UpstreamPlugin)Controls/**;$(UpstreamPlugin)Interface/**" />
    <!-- All of the plugin's UI compiles unchanged against ULDB.Compat (uistubs-ported.txt): MenusForm
         only holds menu items and toolbar buttons; the forms and IntControl have Avalonia views in
         Views/. (Controls/BoolControl isn't in upstream's build.) -->
    <Compile Include="$(UpstreamPlugin)Interface/**/*.cs;$(UpstreamPlugin)Controls/IntControl.cs;$(UpstreamPlugin)Controls/IntControl.designer.cs;$(UpstreamPlugin)Controls/NumericUpDownEx.cs" />
    <Compile Include="Properties/**/*.cs" />
    <!-- ULDB's Avalonia views for the model-ported UI (.axaml), registered by PluginViews. -->
    <Compile Include="Views/**/*.cs" />
    <Compile Include="UIStubs/**/*.cs" />
    <Compile Include="UIStubFixes/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded by the plugin host at runtime from Builder's folder, so not copied here. -->
    <ProjectReference Include="../../Builder/ULDB.Builder.csproj" Private="false" />
    <ProjectReference Include="../../Compat/ULDB.Compat.csproj" Private="false" />
  </ItemGroup>
  <!-- Upstream's embedded resources under the names upstream uses; Plugin.GetResourceStream finds them by suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="$(UpstreamPlugin)Resources/*.cfg;$(UpstreamPlugin)Resources/*.png"
                      LogicalName="CodeImp.DoomBuilder.BuilderEffects.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same Avalonia as Builder (loaded from Builder's folder at runtime); compiles the views' .axaml. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>
  <Import Project="Properties/Resources.g.props" />
  <!-- Into Builder's Plugins folder, like upstream's Build/Plugins. -->
  <Target Name="CopyToBuilderPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildThisFileDirectory)../../Builder/bin/$(Configuration)/net10.0/Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
