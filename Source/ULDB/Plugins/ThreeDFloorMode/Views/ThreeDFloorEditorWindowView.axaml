<!-- ULDB: the window of 3D Floor mode's ThreeDFloorEditorWindow (model-ported: upstream's code runs
     unchanged): one card per 3D floor of the selected sectors, with bulk buttons below. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeImp.DoomBuilder.ThreeDFloorMode.ThreeDFloorEditorWindowView"
        Title="3D floors" Width="1000" Height="680" MinWidth="960" MinHeight="400" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,10,0,0">
      <Button x:Name="addThreeDFloorButton"/>
      <Button x:Name="splitAllButton" Grid.Column="1"/>
      <Button x:Name="detachAllButton" Grid.Column="2"/>
      <Button x:Name="checkAllButton" Grid.Column="3"/>
      <Button x:Name="uncheckAllButton" Grid.Column="4"/>
      <CheckBox x:Name="sharedThreeDFloorsCheckBox" Grid.Column="5" Margin="8,0,0,0"/>
      <Button x:Name="okButton" Grid.Column="7" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center" Classes="accent"/>
      <Button x:Name="cancelButton" Grid.Column="8" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center"/>
    </Grid>
    <Panel>
      <ScrollViewer x:Name="scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="cards"/>
      </ScrollViewer>
      <StackPanel x:Name="no3dfloorspanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock x:Name="label1" Text="There are no 3D floors" Opacity="0.7" HorizontalAlignment="Center"/>
        <Button x:Name="add3dfloorbutton2" HorizontalAlignment="Center"/>
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
