<!-- ULDB: the view of the ColorPicker plugin's ColorPickerSlider (model-ported: upstream's code runs
     unchanged): a label, a slider with its limits (or four preset buttons) and a number box. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeImp.DoomBuilder.ColorPicker.Controls.ColorPickerSliderView">
  <Grid ColumnDefinitions="118,*,Auto" ColumnSpacing="6" Margin="0,2">
    <TextBlock x:Name="label1" Classes="uldb-field" VerticalAlignment="Center"/>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
      <Grid ColumnDefinitions="*,*">
        <TextBlock x:Name="labelMin" FontSize="11" Opacity="0.7"/>
        <TextBlock x:Name="labelMax" Grid.Column="1" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"/>
      </Grid>
      <Slider x:Name="trackBar1" Grid.Row="1" Height="26" MinHeight="26" IsSnapToTickEnabled="True" TickFrequency="1"/>
      <StackPanel Grid.RowSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="button1" MinWidth="40" HorizontalContentAlignment="Center"/>
        <Button x:Name="button2" MinWidth="40" HorizontalContentAlignment="Center"/>
        <Button x:Name="button3" MinWidth="40" HorizontalContentAlignment="Center"/>
        <Button x:Name="button4" MinWidth="40" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NumericUpDown x:Name="numericUpDown1" Grid.Column="2" Width="84" Height="24" MinHeight="24" FormatString="0"/>
  </Grid>
</UserControl>
